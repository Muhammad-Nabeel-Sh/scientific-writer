{
  "productName": "ScientificWriter",
  "version": "0.1.0",
  "identifier": "com.scientific.writer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Scientific Writer",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "db/dicts.sqlite": "db/dicts.sqlite",
      "resources/hunspell/*": "hunspell/"
    }
  },
  "plugins": {}
}