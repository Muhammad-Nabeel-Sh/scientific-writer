exports[`renderMarkdown golden snapshots > renders interlinear-gloss.md 1`] = `
"<h1 dir="auto">التعليقات بين السطور (التعليق بين السطور)</h1>
<p dir="auto">التعليق بين السطور هو طريقة لوضع شرح كلمة أو عبارة بين سطور النص الأصلي. وهي شائعة في كتب التفسير والنحو.</p>
<h2 dir="auto">أمثلة</h2>
<h3 dir="auto">من تفسير القرآن</h3>
<p dir="auto">قال الله تعالى:</p>
<p dir="auto"><span class="interlinear-unit"><span class="interlinear-base">الْحَمْدُ</span><span class="interlinear-gloss">لِلَّهِ</span></span> <span class="interlinear-unit"><span class="interlinear-base">رَبِّ</span><span class="interlinear-gloss">الْعَالَمِينَ</span></span> <span class="interlinear-unit"><span class="interlinear-base">الرَّحْمَـٰنِ</span><span class="interlinear-gloss">الرَّحِيمِ</span></span></p>
<p dir="auto">حيث توضع التعليقات بين سطور النص بخط أصغر.</p>
<h3 dir="auto">من كتب النحو</h3>
<p dir="auto"><span class="interlinear-unit"><span class="interlinear-base">قَالَ</span><span class="interlinear-gloss">فِعْلٌ مَاضٍ</span></span> <span class="interlinear-unit"><span class="interlinear-base">الْمُؤَلِّفُ</span><span class="interlinear-gloss">فَاعِلٌ مَرْفُوعٌ</span></span>: <span class="interlinear-unit"><span class="interlinear-base">&quot;الْفِعْلُ</span><span class="interlinear-gloss">مَا دَلَّ عَلَى حَدَثٍ</span></span> <span class="interlinear-unit"><span class="interlinear-base">ثَلَاثَةُ</span><span class="interlinear-gloss">خَبَرٌ مَرْفُوعٌ</span></span> <span class="interlinear-unit"><span class="interlinear-base">أَنْوَاعٍ</span><span class="interlinear-gloss">مُضَافٌ إِلَيْهِ مَجْرُورٌ</span></span>&quot;</p>
<h3 dir="auto">من متن الأجرومية</h3>
<p dir="auto"><span class="interlinear-unit"><span class="interlinear-base">الْكَلَامُ</span><span class="interlinear-gloss">هُوَ اللَّفْظُ الْمُرَكَّبُ الْمُفِيدُ بِالْوَضْعِ</span></span> وَأَقْسَامُهُ ثَلَاثَةٌ: <span class="interlinear-unit"><span class="interlinear-base">اسْمٌ</span><span class="interlinear-gloss">مَا دَلَّ عَلَى مَعْنًى فِي نَفْسِهِ غَيْرِ مُقْتَرِنٍ بِزَمَانٍ</span></span> <span class="interlinear-unit"><span class="interlinear-base">وَفِعْلٌ</span><span class="interlinear-gloss">مَا دَلَّ عَلَى مَعْنًى فِي نَفْسِهِ مُقْتَرِنٍ بِزَمَانٍ</span></span> <span class="interlinear-unit"><span class="interlinear-base">وَحَرْفٌ</span><span class="interlinear-gloss">مَا دَلَّ عَلَى مَعْنًى فِي غَيْرِهِ</span></span></p>
<h2 dir="auto">ملاحظات</h2>
<ul dir="rtl">
<li dir="auto">
<p dir="auto">يوضع التعليق بين قوسين <span class="interlinear-unit"><span class="interlinear-base">\`</span><span class="interlinear-gloss">…</span></span>) مباشرة بعد الكلمة المراد شرحها</p>
</li>
<li dir="auto">
<p dir="auto">يظهر التعليق بخط صغير أسفل الكلمة</p>
</li>
<li dir="auto">
<p dir="auto">يمكن استخدام هذه الطريقة في المتن والشرح على حد سواء</p>
</li>
</ul>
"
`;
